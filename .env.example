# Copie ce fichier en .env.local et remplace les valeurs.
# .env.local n'est jamais versionné : ne commit jamais de vraies clés.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique (anon / publishable) : utilisable côté navigateur
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service" : UNIQUEMENT côté serveur ou scripts d'import. Jamais préfixée NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
